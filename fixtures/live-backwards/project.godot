; Engine configuration file.
; The workspace for a run that has to use the debugger. The player moves the wrong way and the
; script says nothing about why: the sign is decided inside a helper, from a lookup whose two
; entries are swapped. Reading the file is enough to guess; stopping on the line and asking what
; the local variable holds is what proves it.
;
; The four Input Map actions are declared here, so a run that reaches for `list_input_actions` gets
; a real answer rather than an empty project's.
;
; Everything else is `fixtures/live-project`'s, for the reasons its own comments give.
config_version=5

[application]

config/name="Gofer Live Sweep - Backwards"
run/max_fps=60
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/no_focus=true
window/vsync/vsync_mode=0

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194319,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194321,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
