{
    "name": "gofer",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint . --quiet",
        "lint:fix": "eslint . --fix --quiet",
        "format": "prettier --write . --log-level warn",
        "format:check": "prettier --check . --log-level warn",
        "check": "npm run --silent format:check && npm run --silent lint && npm run --silent typecheck && cargo check --quiet --manifest-path src-tauri/Cargo.toml",
        "preview": "vite preview",
        "tauri": "tauri",
        "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs"
    },
    "dependencies": {
        "@astryxdesign/core": "0.2.0",
        "@astryxdesign/theme-neutral": "0.2.0",
        "@heroicons/react": "2.2.0",
        "@stylexjs/stylex": "0.19.0",
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/plugin-opener": "2.5.4",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.2.0",
        "@eslint/js": "10.0.1",
        "@tauri-apps/cli": "2.11.4",
        "@types/node": "26.1.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.3",
        "globals": "17.8.0",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vite": "8.2.0"
    }
}
