{
    "name": "gofer",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint . --quiet",
        "lint:fix": "eslint . --fix --quiet",
        "format": "prettier --write . --log-level warn",
        "format:check": "prettier --check . --log-level warn",
        "test:frontend": "vitest run",
        "test:worker": "node --test scripts/*.test.mjs",
        "test:rust": "cargo test --quiet --manifest-path src-tauri/Cargo.toml",
        "check:rustfmt": "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
        "check:clippy": "cargo clippy --quiet --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "test": "npm run --silent test:frontend && npm run --silent test:worker && npm run --silent test:rust",
        "check": "npm run --silent format:check && npm run --silent lint && npm run --silent typecheck && npm run --silent check:rustfmt && npm run --silent check:clippy && npm run --silent test && cargo check --quiet --manifest-path src-tauri/Cargo.toml",
        "preview": "vite preview",
        "tauri": "tauri",
        "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs"
    },
    "dependencies": {
        "@astryxdesign/core": "0.2.0",
        "@astryxdesign/theme-neutral": "0.2.0",
        "@earendil-works/pi-agent-core": "0.83.0",
        "@earendil-works/pi-ai": "0.83.0",
        "@heroicons/react": "2.2.0",
        "@huggingface/transformers": "4.2.0",
        "@mjasnikovs/gofer-rag": "0.1.0-canary.1",
        "@stylexjs/stylex": "0.19.0",
        "@tanstack/react-router": "1.170.18",
        "@tauri-apps/api": "2.11.1",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.2.0",
        "@eslint/js": "10.0.1",
        "@tauri-apps/cli": "2.11.4",
        "@testing-library/jest-dom": "7.0.0",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "26.1.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.3",
        "globals": "17.8.0",
        "jsdom": "30.0.1",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vite": "8.2.0",
        "vitest": "4.1.10"
    }
}
