{
    "name": "gofer",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.19.0"
    },
    "overrides": {
        "@wdio/native-utils": "2.5.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tauri build --no-bundle",
        "build:renderer": "tsc --noEmit && vite build",
        "build:frontend": "npm run --silent build:renderer && npm run --silent build:workers",
        "build:frontend:webdriver": "npm run --silent build:renderer -- --mode webdriver && npm run --silent build:workers",
        "build:workers": "node scripts/build-workers.mjs",
        "typecheck": "tsc --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
        "lint": "eslint . --quiet",
        "lint:fix": "eslint . --fix --quiet",
        "format": "prettier --write . --log-level warn",
        "format:check": "prettier --check . --log-level warn",
        "test:frontend": "vitest run",
        "test:visual": "playwright test",
        "test:visual:update": "playwright test --update-snapshots",
        "test:desktop:browser": "start-server-and-test 'npm run dev -- --host 127.0.0.1' http://127.0.0.1:1420 'wdio run wdio.browser.conf.ts'",
        "test:desktop:packaged": "node scripts/run-packaged-journey.mjs",
        "test:live": "wdio run wdio.live.conf.ts",
        "test:blank": "wdio run wdio.blank.conf.ts",
        "test:live:brief": "wdio run wdio.brief.conf.ts",
        "test:live:build": "npm run --silent build:desktop:test && npm run --silent test:live",
        "test:live:reset": "node scripts/reset-live-sweep.mjs",
        "test:worker:bundled": "npm run --silent build:workers && GOFER_WORKER_ENTRY=src-tauri/workers/ai-worker.mjs node --test scripts/ai-worker.test.mjs",
        "test:worker": "node --test scripts/brief/deadline.test.mjs scripts/brief/outcome.test.mjs scripts/brief/phases.test.mjs scripts/brief/run.test.mjs scripts/ai-credentials.test.mjs scripts/ai-extract.test.mjs scripts/ai-fetch.test.mjs scripts/ai-search.test.mjs scripts/ai-subagent.test.mjs scripts/ai-transcript.test.mjs scripts/ai-web-clean.test.mjs scripts/ai-worker.test.mjs scripts/design-rules.test.mjs scripts/memory-embedder.test.mjs scripts/protocol.test.mjs scripts/rag-ask.test.mjs scripts/rag-expand.test.mjs scripts/rag-progress.test.mjs scripts/rag-retrieve.test.mjs scripts/workspace-confinement.test.mjs",
        "test:godot": "node scripts/godot-test.mjs && npm run --silent test:godot:addon",
        "test:godot:addon": "node scripts/godot-acceptance.mjs",
        "test:godot:api": "node scripts/godot-api-drift.mjs",
        "test:rust": "cargo test --quiet --manifest-path src-tauri/Cargo.toml",
        "test:coverage:node": "c8 --all --include='scripts/*.mjs' --exclude='scripts/*.test.mjs' --exclude='scripts/check.mjs' --exclude='scripts/godot-test.mjs' --exclude='scripts/godot-acceptance.mjs' --exclude='scripts/godot-api-drift.mjs' --exclude='scripts/design-check.mjs' --exclude='scripts/setup-hooks.mjs' --exclude='scripts/check-ignored-tests.mjs' --exclude='scripts/check-command-surface.mjs' --exclude='scripts/generate-command-surface.mjs' --exclude='scripts/check-rust-critical-coverage.mjs' --exclude='scripts/run-rust-coverage.mjs' --exclude='scripts/run-packaged-journey.mjs' --exclude='scripts/install-godot.mjs' --exclude='scripts/build-gdformat.mjs' --exclude='scripts/build-workers.mjs' --exclude='scripts/godot-binary.mjs' --exclude='scripts/memory-worker.mjs' --exclude='scripts/rag-warmup.mjs' --exclude='scripts/rag-retrieve-worker.mjs' --exclude='scripts/bench-alone.mjs' --reporter=text --check-coverage --lines 80 --branches 75 npm run --silent test:worker",
        "test:coverage:node-critical": "c8 --include='scripts/workspace-confinement.mjs' --reporter=text --check-coverage --lines 100 --branches 100 --functions 100 --statements 100 node --test scripts/workspace-confinement.test.mjs",
        "test:coverage:frontend": "vitest run --coverage",
        "test:coverage:rust:report": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --all-targets --summary-only",
        "test:coverage:rust": "node scripts/run-rust-coverage.mjs",
        "generate": "node scripts/generate-command-surface.mjs",
        "build:gdformat": "node scripts/build-gdformat.mjs",
        "build:desktop:test": "tauri build --no-bundle --config src-tauri/tauri.wdio.conf.json --features webdriver",
        "check:rustfmt": "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
        "check:clippy": "cargo clippy --quiet --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "check:ignored-tests": "node scripts/check-ignored-tests.mjs",
        "check:command-surface": "node scripts/check-command-surface.mjs",
        "check:design": "node scripts/design-check.mjs",
        "check:cargo": "cargo check --quiet --manifest-path src-tauri/Cargo.toml",
        "test": "npm run --silent test:coverage:frontend && npm run --silent test:coverage:node && npm run --silent test:coverage:node-critical && npm run --silent test:rust && npm run --silent test:godot && npm run --silent test:desktop:browser",
        "check": "node scripts/check.mjs",
        "prepare": "node scripts/setup-hooks.mjs",
        "preview": "vite preview",
        "tauri": "tauri",
        "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs"
    },
    "dependencies": {
        "@astryxdesign/core": "0.2.0",
        "@astryxdesign/theme-neutral": "0.2.0",
        "@earendil-works/pi-agent-core": "0.83.0",
        "@earendil-works/pi-ai": "0.83.0",
        "@heroicons/react": "2.2.0",
        "@huggingface/transformers": "4.2.0",
        "@mjasnikovs/gofer-rag": "0.1.3",
        "@mozilla/readability": "0.6.0",
        "@stylexjs/stylex": "0.19.0",
        "@tanstack/react-router": "1.170.18",
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "linkedom": "0.18.13",
        "monaco-editor": "0.56.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "turndown": "7.2.4"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.2.0",
        "@axe-core/playwright": "4.12.1",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.62.1",
        "@tauri-apps/cli": "2.11.4",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@testing-library/jest-dom": "7.0.0",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "26.1.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "@vitest/coverage-v8": "4.1.10",
        "@wdio/cli": "^9.30.0",
        "@wdio/globals": "^9.29.1",
        "@wdio/local-runner": "^9.30.0",
        "@wdio/mocha-framework": "^9.30.0",
        "@wdio/tauri-plugin": "^1.2.0",
        "@wdio/tauri-service": "^1.2.0",
        "ajv": "8.17.1",
        "axe-core": "4.10.2",
        "c8": "10.1.3",
        "esbuild": "0.28.1",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.3",
        "globals": "17.8.0",
        "jsdom": "30.0.1",
        "prettier": "3.9.6",
        "start-server-and-test": "^3.0.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vite": "8.2.0",
        "vitest": "4.1.10"
    }
}
