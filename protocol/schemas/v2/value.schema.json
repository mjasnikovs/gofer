{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://gofer.local/protocol/v2/value.schema.json",
    "title": "Gofer protocol v2 tagged Godot value",
    "description": "Every tag is the spelling type_string gives that Variant type. node, object and opaque are lowercase because they describe something the wire cannot rebuild, and Resource is the one object shape it can.",
    "type": "object",
    "required": ["type"],
    "properties": {"type": {"type": "string"}},
    "additionalProperties": true,
    "oneOf": [
        {"properties": {"type": {"const": "Nil"}, "value": {"type": "null"}}},
        {
            "required": ["value"],
            "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}
        },
        {
            "required": ["value"],
            "properties": {"type": {"const": "int"}, "value": {"type": "integer"}}
        },
        {
            "required": ["value"],
            "properties": {"type": {"const": "float"}, "value": {"type": "number"}}
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"enum": ["String", "StringName", "NodePath"]},
                "value": {"type": "string"}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Array"},
                "value": {"type": "array", "items": {"$ref": "#"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Dictionary"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["key", "value"],
                        "properties": {"key": {"$ref": "#"}, "value": {"$ref": "#"}},
                        "additionalProperties": true
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector2"},
                "value": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector2i"},
                "value": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "integer"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector3"},
                "value": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector3i"},
                "value": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {"type": "integer"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"enum": ["Vector4", "Quaternion", "Color", "Plane", "Rect2"]},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"enum": ["Vector4i", "Rect2i"]},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "integer"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"enum": ["Transform2D", "AABB"]},
                "value": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Basis"},
                "value": {
                    "type": "array",
                    "minItems": 9,
                    "maxItems": 9,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Transform3D"},
                "value": {
                    "type": "array",
                    "minItems": 12,
                    "maxItems": 12,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Projection"},
                "value": {
                    "type": "array",
                    "minItems": 16,
                    "maxItems": 16,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"enum": ["PackedByteArray", "PackedInt32Array", "PackedInt64Array"]},
                "value": {"type": "array", "items": {"type": "integer"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"enum": ["PackedFloat32Array", "PackedFloat64Array"]},
                "value": {"type": "array", "items": {"type": "number"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedStringArray"},
                "value": {"type": "array", "items": {"type": "string"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedVector2Array"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {"type": "number"}
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedVector3Array"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {"type": "number"}
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"enum": ["PackedVector4Array", "PackedColorArray"]},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": {"type": "number"}
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Resource"},
                "value": {
                    "type": "object",
                    "required": ["path", "resourceType"],
                    "properties": {
                        "path": {"type": "string", "minLength": 1},
                        "resourceType": {"type": "string", "minLength": 1},
                        "uid": {"type": "string", "minLength": 1}
                    },
                    "additionalProperties": true
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "node"},
                "value": {
                    "type": "object",
                    "required": ["path", "nodeType"],
                    "properties": {
                        "path": {"type": "string", "minLength": 1},
                        "nodeType": {"type": "string", "minLength": 1},
                        "instanceId": {"type": "integer"}
                    },
                    "additionalProperties": true
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "object"},
                "value": {
                    "type": "object",
                    "required": ["className", "instanceId"],
                    "properties": {
                        "className": {"type": "string", "minLength": 1},
                        "instanceId": {"type": "integer"}
                    },
                    "additionalProperties": true
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "opaque"},
                "value": {
                    "type": "object",
                    "required": ["typeName", "text"],
                    "properties": {
                        "typeName": {"type": "string", "minLength": 1},
                        "text": {"type": "string"}
                    },
                    "additionalProperties": true
                }
            }
        }
    ]
}
