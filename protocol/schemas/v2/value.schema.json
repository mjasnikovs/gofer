{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://gofer.local/protocol/v2/value.schema.json",
    "title": "Gofer protocol v2 tagged Godot value",
    "description": "Every tag is the spelling type_string gives that Variant type, and every payload is the one shape that tag takes. Generated by scripts/generate-command-surface.mjs from the same table the godot tool and the router read.",
    "type": "object",
    "required": ["type"],
    "properties": {"type": {"type": "string"}},
    "additionalProperties": true,
    "oneOf": [
        {"properties": {"type": {"const": "Nil"}, "value": {"type": "null"}}},
        {
            "required": ["value"],
            "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}
        },
        {
            "required": ["value"],
            "properties": {"type": {"const": "int"}, "value": {"type": "integer"}}
        },
        {
            "required": ["value"],
            "properties": {"type": {"const": "float"}, "value": {"type": "number"}}
        },
        {
            "required": ["value"],
            "properties": {"type": {"const": "String"}, "value": {"type": "string"}}
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector2"},
                "value": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector2i"},
                "value": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "integer"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Rect2"},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Rect2i"},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "integer"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector3"},
                "value": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector3i"},
                "value": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {"type": "integer"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Transform2D"},
                "value": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector4"},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Vector4i"},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "integer"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Plane"},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Quaternion"},
                "value": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "AABB"},
                "value": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Basis"},
                "value": {
                    "type": "array",
                    "minItems": 9,
                    "maxItems": 9,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Transform3D"},
                "value": {
                    "type": "array",
                    "minItems": 12,
                    "maxItems": 12,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Projection"},
                "value": {
                    "type": "array",
                    "minItems": 16,
                    "maxItems": 16,
                    "items": {"type": "number"}
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Color"},
                "value": {
                    "oneOf": [
                        {
                            "type": "array",
                            "minItems": 4,
                            "maxItems": 4,
                            "items": {"type": "number"}
                        },
                        {"type": "string"}
                    ]
                }
            }
        },
        {
            "required": ["value"],
            "properties": {"type": {"const": "StringName"}, "value": {"type": "string"}}
        },
        {
            "required": ["value"],
            "properties": {"type": {"const": "NodePath"}, "value": {"type": "string"}}
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Dictionary"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {"key": {"$ref": "#"}, "value": {"$ref": "#"}},
                        "required": ["key", "value"],
                        "additionalProperties": false
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Array"},
                "value": {"type": "array", "items": {"$ref": "#"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedByteArray"},
                "value": {"type": "array", "items": {"type": "integer"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedInt32Array"},
                "value": {"type": "array", "items": {"type": "integer"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedInt64Array"},
                "value": {"type": "array", "items": {"type": "integer"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedFloat32Array"},
                "value": {"type": "array", "items": {"type": "number"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedFloat64Array"},
                "value": {"type": "array", "items": {"type": "number"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedStringArray"},
                "value": {"type": "array", "items": {"type": "string"}}
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedVector2Array"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {"type": "number"}
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedVector3Array"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {"type": "number"}
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedColorArray"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": {"type": "number"}
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "PackedVector4Array"},
                "value": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": {"type": "number"}
                    }
                }
            }
        },
        {
            "required": ["value"],
            "properties": {
                "type": {"const": "Resource"},
                "value": {
                    "type": "object",
                    "properties": {"path": {"type": "string", "minLength": 1}},
                    "required": ["path"],
                    "additionalProperties": false
                }
            }
        },
        {
            "$comment": "Answer only: a resource comes back naming its class and its UID.",
            "required": ["value"],
            "properties": {
                "type": {"const": "Resource"},
                "value": {
                    "type": "object",
                    "required": ["path", "resourceType"],
                    "properties": {
                        "path": {"type": "string", "minLength": 1},
                        "resourceType": {"type": "string", "minLength": 1},
                        "uid": {"type": "string", "minLength": 1}
                    },
                    "additionalProperties": true
                }
            }
        },
        {
            "$comment": "Answer only: node describes something live, which no payload rebuilds.",
            "required": ["value"],
            "properties": {
                "type": {"const": "node"},
                "value": {
                    "type": "object",
                    "required": ["path", "nodeType"],
                    "properties": {
                        "path": {"type": "string", "minLength": 1},
                        "nodeType": {"type": "string", "minLength": 1},
                        "instanceId": {"type": "integer"}
                    },
                    "additionalProperties": true
                }
            }
        },
        {
            "$comment": "Answer only: object describes something live, which no payload rebuilds.",
            "required": ["value"],
            "properties": {
                "type": {"const": "object"},
                "value": {
                    "type": "object",
                    "required": ["className", "instanceId"],
                    "properties": {
                        "className": {"type": "string", "minLength": 1},
                        "instanceId": {"type": "integer"}
                    },
                    "additionalProperties": true
                }
            }
        },
        {
            "$comment": "Answer only: opaque describes something live, which no payload rebuilds.",
            "required": ["value"],
            "properties": {
                "type": {"const": "opaque"},
                "value": {
                    "type": "object",
                    "required": ["typeName", "text"],
                    "properties": {
                        "typeName": {"type": "string", "minLength": 1},
                        "text": {"type": "string"}
                    },
                    "additionalProperties": true
                }
            }
        }
    ]
}
